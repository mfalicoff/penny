{
  // Repository tooling and its tests (Node 24, which strips the types when it runs them).
  "compilerOptions": {
    "target": "ES2024",
    // ES modules resolved by the bundler rules, with the DOM lib for fetch/Response types.
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
