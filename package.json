{
  "name": "expense_tracker",
  "version": "2.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@~7.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.2",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "npm run test:core",
    "test:coverage": "c8 npm run test:core",
    "typecheck": "tsc --noEmit",
    "version": "npm run version:check",
    "version:check": "node scripts/check-version.mjs",
    "lint": "eslint --max-warnings=0 src tests scripts",
    "test:core": "node --test tests/core/*.test.ts",
    "test:fullstack": "node --test --test-concurrency=1 tests/fullstack/*.test.mjs",
    "test-env": "node scripts/test-env/penny-env.mjs",
    "fixtures:generate": "node --experimental-strip-types --no-warnings scripts/fixtures/generate-golden.ts",
    "fixtures:check": "node --experimental-strip-types --no-warnings scripts/fixtures/generate-golden.ts --check",
    "dashboards:generate": "node scripts/grafana-dashboards.mjs",
    "dashboards:check": "node scripts/grafana-dashboards.mjs --check"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reports-dir": "coverage/core",
    "temp-directory": "coverage/core/tmp",
    "reporter": [
      "text-summary",
      "html",
      "lcovonly",
      "json-summary"
    ]
  },
  "private": true
}
