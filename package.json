{
  "name": "expense_tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "cors": "^2.8.6",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.26",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "c8": "^12.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run prepare:pdf && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run prepare:pdf && expo start --web",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "npm run test:core && npm run test:ui",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:ui",
    "test:coverage:core": "c8 npm run test:core",
    "test:coverage:ui": "npm run test:ui -- --coverage",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run prepare:pdf && expo export --platform web",
    "prepare:pdf": "node scripts/copy-pdf-worker.mjs",
    "lint": "expo lint src server tests scripts playwright.config.ts",
    "test:core": "node --test tests/core/*.test.ts",
    "test:ui": "jest --runInBand",
    "test:ui:ios": "jest --runInBand --selectProjects ios",
    "test:ui:android": "jest --runInBand --selectProjects android",
    "test:ui:web": "jest --runInBand --selectProjects web",
    "test:e2e": "npm run test:e2e:web",
    "test:e2e:web": "node scripts/run-playwright.mjs",
    "test:e2e:ios": "node scripts/run-native-tests.mjs ios",
    "test:e2e:android": "node scripts/run-native-tests.mjs android",
    "test:e2e:native": "node scripts/run-native-tests.mjs all",
    "test:e2e:check": "node scripts/run-native-tests.mjs --check",
    "test:all": "npm test && npm run test:e2e:web && npm run test:e2e:native",
    "test:ui:watch": "jest --watch"
  },
  "c8": {
    "all": true,
    "src": ["server", "src/domain"],
    "include": ["server/**/*.ts", "src/domain/**/*.ts"],
    "exclude": ["**/*.d.ts"],
    "extension": [".ts"],
    "reports-dir": "coverage/core",
    "temp-directory": "coverage/core/tmp",
    "reporter": ["text-summary", "html", "lcovonly", "json-summary"]
  },
  "private": true
}
