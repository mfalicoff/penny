{
  "name": "expense_tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "cors": "^2.8.6",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run prepare:pdf && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run prepare:pdf && expo start --web",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run prepare:pdf && expo export --platform web",
    "prepare:pdf": "node scripts/copy-pdf-worker.mjs",
    "lint": "expo lint"
  },
  "private": true
