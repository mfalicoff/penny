# Development: Expo web at localhost:8081, API at localhost:3001.
# For a physical phone use your server's LAN IP or HTTPS hostname, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
PORT=3001
DATABASE_PATH=./data/penny.sqlite
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Production example behind an HTTPS reverse proxy:
# CORS_ORIGINS=https://penny.example.com
# COOKIE_SECURE=true
# After creating your own account, set ALLOW_REGISTRATION=false.
