# Development: legacy API at localhost:3001 (the browser app is apps/web).
PORT=3001
DATABASE_PATH=./data/penny.sqlite
CORS_ORIGINS=http://localhost:3001
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Production example behind an HTTPS reverse proxy:
# CORS_ORIGINS=https://penny.example.com
# COOKIE_SECURE=true
# After creating your own account, set ALLOW_REGISTRATION=false.

# Optional OIDC. Register EXACT redirect URIs with your identity provider.
# Keep the client secret on the server.
# OIDC_ISSUER=https://identity.example.com/realms/penny
# OIDC_CLIENT_ID=penny
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URIS=https://penny.example.com/auth/callback,penny://auth/callback
# OIDC_LABEL=Single sign-on
# Enable provisioning explicitly, then disable it to restrict access to existing users.
OIDC_ALLOW_REGISTRATION=false
