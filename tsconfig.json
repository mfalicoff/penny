{
  // The shared TypeScript rules, the ledger write schema, tests and scripts (Node 24, run with
  // --experimental-strip-types).
  "compilerOptions": {
    "target": "ES2024",
    // ES modules resolved by the bundler rules, with the DOM lib for fetch/Response types.
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "apps", "design-kit"]
}
