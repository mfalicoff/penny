{
  "name": "@penny/web",
  "version": "0.0.0",
  "private": true,
  "description": "Penny v2 browser app: React, TypeScript, Vite, TanStack Router and TanStack Query (MAZ-83).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-dist.ts",
    "preview": "vite preview",
    "design:sync": "node scripts/sync-design.ts",
    "design:check": "node scripts/sync-design.ts --check",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/e2e-real.ts",
    "test:e2e:cards": "PENNY_CARDS=1 PENNY_E2E_BROWSERS=chromium PENNY_E2E_DEVICES=desktop node scripts/e2e-real.ts cards.real",
    "check": "npm run design:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.14.0",
    "@grafana/faro-web-tracing": "2.14.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
