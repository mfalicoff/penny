{
  "name": "penny-site",
  "private": true,
  "description": "Penny's product page: a static site with procedurally generated Gaussian splats, served by Cloudflare Workers static assets.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "splats:export": "node scripts/export-splats.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
