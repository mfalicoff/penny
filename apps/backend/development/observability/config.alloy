// Telemetry pipeline shared by local development (MAZ-138, Aspire) and the operator
// reference stack (MAZ-128, compose.yaml next to this file). Alloy batches each signal and
// forwards it to its store: traces to Tempo, logs to Loki, metrics to Prometheus.
//
// Everything arrives on the container network from the Penny API. Nothing here is published:
//
// * Internal OTLP (gRPC 4317, HTTP 4318): the API's own traces, metrics and logs.
// * Client telemetry (MAZ-129): the web and iOS apps post to the API's authenticated
//   /api/telemetry endpoint, which checks, scrubs and forwards it here: Faro to 12347
//   (ClientTelemetry__FaroUrl=http://alloy:12347/collect) and OTLP/HTTP to 4319
//   (ClientTelemetry__OtlpEndpoint=http://alloy:4319). Browsers never reach Alloy, so there
//   is no CORS; the client receivers still accept only the client service names, so nothing
//   forwarded for a client can look like the API.
//
// Settings (environment, optional):
//   PENNY_CLIENT_SERVICES     regular expression of accepted client service.name values
//                             (default: penny-web|penny-ios)

// --- Internal OTLP (API) ------------------------------------------------------------------

otelcol.receiver.otlp "internal" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// --- Client telemetry, forwarded by the API (web and iOS) -----------------------------------

otelcol.receiver.otlp "clients" {
  http {
    endpoint              = "0.0.0.0:4319"
    max_request_body_size = "1MiB"
    include_metadata      = false
  }

  output {
    metrics = [otelcol.processor.filter.clients.input]
    logs    = [otelcol.processor.filter.clients.input]
    traces  = [otelcol.processor.filter.clients.input]
  }
}

// Drops anything that does not claim a client service name, so client telemetry can never
// impersonate the API (penny-backend) in dashboards and alerts. The API checks this too.
otelcol.processor.filter "clients" {
  error_mode = "ignore"

  traces {
    span = [string.format("not IsMatch(resource.attributes[\"service.name\"], \"^(%s)$\")", coalesce(sys.env("PENNY_CLIENT_SERVICES"), "penny-web|penny-ios"))]
  }

  logs {
    log_record = [string.format("not IsMatch(resource.attributes[\"service.name\"], \"^(%s)$\")", coalesce(sys.env("PENNY_CLIENT_SERVICES"), "penny-web|penny-ios"))]
  }

  metrics {
    metric = [string.format("not IsMatch(resource.attributes[\"service.name\"], \"^(%s)$\")", coalesce(sys.env("PENNY_CLIENT_SERVICES"), "penny-web|penny-ios"))]
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Grafana Faro Web SDK reports, forwarded by the API (POST /collect). Errors, logs, events and web vitals become
// Loki lines labelled service_name="penny-web"; Faro traces join the OTLP pipeline.
faro.receiver "web" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    max_allowed_payload_size = "1MiB"

    rate_limiting {
      enabled    = true
      rate       = 50
      burst_size = 100
    }
  }

  output {
    logs   = [loki.process.faro.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

loki.process "faro" {
  stage.static_labels {
    values = {
      service_name  = "penny-web",
      telemetry_sdk = "faro",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// --- Batching and export -------------------------------------------------------------------

otelcol.processor.batch "default" {
  timeout = "2s"

  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Prometheus' native OTLP receiver (started with --web.enable-otlp-receiver).
otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

// Loki's native OTLP endpoint.
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
