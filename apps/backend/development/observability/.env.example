# Settings for the reference Grafana stack (compose.yaml next to this file). Copy to .env,
# keep it private (chmod 600) and set the Grafana administrator password:
#
#   cp .env.example .env && chmod 600 .env
#   openssl rand -base64 24   # GRAFANA_ADMIN_PASSWORD
#
# Every variable is documented in docs/observability.md#configuration.

GRAFANA_ADMIN_PASSWORD=
# The address users open Grafana at, when a reverse proxy publishes it over HTTPS.
# GRAFANA_ROOT_URL=https://grafana.example.com/
# GRAFANA_SECURE_COOKIES=true

# Browser origins allowed to send client telemetry (comma-separated): your Penny origin.
PENNY_TELEMETRY_ORIGINS=https://penny.example.com

# Retention. Logs and traces are deleted after these durations; metrics after the time or
# once they reach the size, whichever comes first.
PENNY_LOGS_RETENTION=168h
PENNY_TRACES_RETENTION=72h
PENNY_METRICS_RETENTION=15d
PENNY_METRICS_MAX_SIZE=5GB
