    {
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 44
      },
      "type": "timeseries",
      "title": "Web vitals (p75)",
      "description": "75th percentile of what browsers measured. Good is LCP under 2.5 s, INP under 200 ms, FCP under 1.8 s and TTFB under 800 ms.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.75, {service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"measurement\" and type = \"web-vitals\" and value_lcp != \"\" | unwrap value_lcp | __error__ = \"\" [$__auto]) by ()",
          "legendFormat": "LCP",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.75, {service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"measurement\" and type = \"web-vitals\" and value_inp != \"\" | unwrap value_inp | __error__ = \"\" [$__auto]) by ()",
          "legendFormat": "INP",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "C",
          "expr": "quantile_over_time(0.75, {service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"measurement\" and type = \"web-vitals\" and value_fcp != \"\" | unwrap value_fcp | __error__ = \"\" [$__auto]) by ()",
          "legendFormat": "FCP",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "D",
          "expr": "quantile_over_time(0.75, {service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"measurement\" and type = \"web-vitals\" and value_ttfb != \"\" | unwrap value_ttfb | __error__ = \"\" [$__auto]) by ()",
          "legendFormat": "TTFB",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 44
      },
      "type": "stat",
      "title": "Layout shift (CLS p75)",
      "description": "Cumulative layout shift; under 0.1 is good.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.75, {service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"measurement\" and type = \"web-vitals\" and value_cls != \"\" | unwrap value_cls | __error__ = \"\" [$__range]) by ()",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "type": "timeseries",
      "title": "Web activity",
      "description": "Faro events: sessions, page loads and navigation, resource timings and traced API calls.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (event_name) (count_over_time({service_name=\"$web_app\"} | logfmt | drop __error__, __error_details__ | kind = \"event\" [$__auto]))",
          "legendFormat": "{{event_name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 17,
      "title": "Telemetry intake (API)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "panels": []
    },
    {
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 61
      },
      "type": "timeseries",
      "title": "Reports by kind and outcome",
      "description": "accepted reports were queued; forwarded reached the collector. duplicate is a retry with a seen Idempotency-Key, invalid failed the shape check, dropped means the queue was full, refused and failed are the collector's answers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum by (penny_telemetry_kind, penny_outcome) (increase(penny_client_telemetry_reports_total{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\"}[$__interval]))",
          "legendFormat": "{{penny_telemetry_kind}} {{penny_outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* (failed|refused)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 61
      },
      "type": "timeseries",
      "title": "Refusals by status",
      "description": "400 shape check, 401 no session, 404 telemetry off, 413 over ClientTelemetry__MaxPayloadBytes, 415 not uncompressed JSON, 429 over ClientTelemetry__RateLimitPermits per session.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum by (http_response_status_code, http_route) (increase(http_server_request_duration_seconds_count{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\", http_route=~\"api/telemetry/.*\", http_response_status_code=~\"4..\"}[$__interval]))",
          "legendFormat": "{{http_response_status_code}} {{http_route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 20,
      "title": "Client traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "panels": []
    },
    {
      "id": 21,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 70
      },
      "type": "table",
      "title": "Failed client operations",
      "description": "Client spans that failed. Their API calls continue into penny-backend in the same trace.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"$web_app|penny-ios\" && status = error }",
          "limit": 25,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 22,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 70
      },
      "type": "table",
      "title": "Slow API calls from clients (over $slow)",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"$web_app|penny-ios\" && kind = client && duration > $slow }",
          "limit": 25,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
