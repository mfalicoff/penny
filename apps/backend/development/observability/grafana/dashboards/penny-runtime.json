          "refId": "A",
          "expr": "sum(rate(dotnet_monitor_lock_contentions_total{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "contentions / s",
