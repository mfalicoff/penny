      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum(rate(dotnet_gc_pause_time_seconds_total{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "paused",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
