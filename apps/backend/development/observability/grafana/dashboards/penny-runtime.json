        "w": 8,
        "x": 8,
        "y": 28
      },
      "type": "timeseries",
      "title": "Connection duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
