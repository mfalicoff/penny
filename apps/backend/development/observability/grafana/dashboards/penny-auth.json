      "title": "Ledger save conflicts (409)",
      "description": "PUT /api/ledger refused because the revision moved on. Occasional conflicts are normal with several devices; a steady stream means a client keeps retrying a stale revision.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum(increase(penny_ledger_conflicts_total{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\"}[$__interval]))",
          "legendFormat": "conflicts",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
