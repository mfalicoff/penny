          "refId": "A",
          "expr": "sum by (penny_outcome, error_type) (increase(penny_household_joins_total{job=\"$service\", instance=~\"$instance\", deployment_environment_name=~\"$environment\"}[$__interval]))",
          "legendFormat": "{{penny_outcome}} {{error_type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
