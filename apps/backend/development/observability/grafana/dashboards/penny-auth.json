      },
      "type": "logs",
      "title": "Auth warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{service_name=\"$service\", service_instance_id=~\"$instance\", deployment_environment_name=~\"$environment\"} | severity_number >= 13 | scope_name =~ \"(?i).*(auth|identity|oidc|ratelimit).*\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
