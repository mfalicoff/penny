<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's App Group: the widgets read the snapshot the app writes (docs/ios-widgets.md).
	     The legacy com.mfalicoff.penny.ExpoWidgetsTarget App ID already has it (docs/ios-ipa.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mfalicoff.penny</string>
	</array>
</dict>
</plist>
