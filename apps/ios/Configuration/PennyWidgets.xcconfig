// The WidgetKit extension (MAZ-80), embedded in Penny.app. The bundle id is the one Expo's
// expo-widgets plugin generated (PennyDomain.AppIdentity): changing it removes placed widgets.
PRODUCT_NAME = PennyWidgets
PRODUCT_BUNDLE_IDENTIFIER = com.mfalicoff.penny.ExpoWidgetsTarget
INFOPLIST_FILE = Configuration/PennyWidgets-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Penny
SKIP_INSTALL = YES
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks

// Signing (README.md#signing-and-entitlements). Same team and App Group as the app.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Configuration/PennyWidgets.entitlements
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
#include? "Signing.local.xcconfig"
