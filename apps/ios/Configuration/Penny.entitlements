<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension; the same group as the legacy Expo app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mfalicoff.penny</string>
	</array>
	<!-- APNs (MAZ-79). Xcode signs development builds for the sandbox; exporting for TestFlight or
	     the App Store rewrites it to production. The App ID needs the Push Notifications capability
	     (docs/ios-notifications.md#apple-developer-setup). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
