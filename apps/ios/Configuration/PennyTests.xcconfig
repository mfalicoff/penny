// Unit tests hosted in the app, so they read the built Info.plist and bundle.
PRODUCT_NAME = PennyTests
PRODUCT_BUNDLE_IDENTIFIER = com.mfalicoff.penny.tests
GENERATE_INFOPLIST_FILE = YES
TEST_HOST = $(BUILT_PRODUCTS_DIR)/Penny.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Penny
BUNDLE_LOADER = $(TEST_HOST)
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
#include? "Signing.local.xcconfig"
