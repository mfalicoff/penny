// The app target. The bundle id, App Group and URL scheme are frozen for TestFlight/App Store
// continuity (PennyDomain.AppIdentity); changing them breaks in-place upgrades.
PRODUCT_NAME = Penny
PRODUCT_BUNDLE_IDENTIFIER = com.mfalicoff.penny
INFOPLIST_FILE = Configuration/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Penny
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.finance
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_NSFaceIDUsageDescription = Allow Penny to use Face ID to protect your financial information.
// MAZ-75: asked only when the person opens the invite QR scanner on the join screen.
INFOPLIST_KEY_NSCameraUsageDescription = Penny uses the camera only to scan a household invite QR code. Nothing is recorded or saved.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Signing (README.md#signing). Simulator builds sign ad hoc and need no team. For a
// device, put DEVELOPMENT_TEAM in the git-ignored Configuration/Signing.local.xcconfig.
// TestFlight archives in CI sign manually: `ios.sh archive` sets the PENNY_* values below
// (docs/ios-ipa.md#signing). They are set here, on the app target only, because a profile
// passed straight to xcodebuild would also apply to the PennyKit package targets.
CODE_SIGN_STYLE = $(PENNY_CODE_SIGN_STYLE:default=Automatic)
CODE_SIGN_ENTITLEMENTS = Configuration/Penny.entitlements
CODE_SIGN_IDENTITY = $(PENNY_CODE_SIGN_IDENTITY:default=Apple Development)
PROVISIONING_PROFILE_SPECIFIER = $(PENNY_PROFILE_SPECIFIER)
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
#include? "Signing.local.xcconfig"
