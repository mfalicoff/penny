# Optional API settings for deploy/compose.yaml (MAZ-63). Copy to deploy/api.env
# (mode 0600) and uncomment what you use; it is passed to the `api` service only.
# Every key is documented in docs/self-hosting/deployment.md#configuration.

# Registration
# Auth__AllowRegistration=true

# OpenID Connect sign-in (all of Issuer, ClientId and RedirectUris, or none)
# Oidc__Issuer=https://auth.example.com/application/o/penny/
# Oidc__ClientId=penny
# Oidc__ClientSecret=
# Oidc__RedirectUris=https://penny.example.com/auth/callback,penny://auth/callback
# Oidc__Label=Single sign-on
# Oidc__AllowRegistration=false

# APNs push (all four, or none). Prefer the PEM text from your secret manager; a key
# file must be mounted read-only and readable by uid 1654.
# Push__Apns__TeamId=
# Push__Apns__KeyId=
# Push__Apns__Topic=
# Push__Apns__PrivateKey=

# Email (password reset links and invitations; see docs/self-hosting/email.md). Off unless
# Email__Smtp__Host is set. Email__AppUrl must be one of Auth__AllowedOrigins.
# Cloudflare Email Service (beta): implicit TLS on 465, username api_token, an API token
# with Email Sending: Edit as the password. Other providers: their host, starttls on 587.
# Email__Smtp__Host=smtp.mx.cloudflare.net
# Email__Smtp__Security=tls
# Email__Smtp__Port=465
# Email__Smtp__Username=api_token
# Email__Smtp__Password=
# Email__From=penny@example.com
# Email__AppUrl=https://penny.example.com

# Workers: run them in exactly the processes you choose (see docs/self-hosting/deployment.md#topology)
# Recurrence__Worker=true
# Push__Worker=true
# Search__EmbeddingWorker=true
# Ocr__Worker=true
# Email__Worker=true

# Receipt text extraction on this server (see docs/self-hosting/operations.md#receipt-text-ocr).
# The image ships Tesseract with eng and fra; other languages need a derived image.
# Ocr__Languages=eng+fra
# Ocr__Concurrency=1
# Ocr__TimeoutSeconds=120
# Ocr__MaxPages=10
# Ocr__MaxFileMegabytes=10

# Emailed receipts (MAZ-184, docs/plans/email-receipts.md). Off by default. Needs the
# email-receipts Compose profile (penny-render) and the Cloudflare Email Worker.
# InboundMail__Enabled=true
# InboundMail__Domain=receipts.example.com
# InboundMail__WebhookSecret=            # openssl rand -base64 32; also the Worker's PENNY_WEBHOOK_SECRET
# InboundMail__Worker=true
# InboundMail__RendererUrl=http://penny-render:3000
# InboundMail__AuthServId=mx.cloudflare.net
# InboundMail__MaxMessageBytes=26214400
# InboundMail__AddressLifetimeDays=90
# InboundMail__InboxRetentionDays=30

# Limits
# Database__MaxPoolSize=20
# Receipts__MinFreeMegabytes=100
# Receipts__UnlinkedRetentionDays=30
# Receipts__CleanupWorker=true
# Logging__LogLevel__Default=Information

# OpenTelemetry traces, metrics and logs over OTLP (off unless the endpoint is set).
# See docs/self-hosting/operations.md#telemetry-opentelemetry. Headers are a secret.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=penny-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=home
# OTEL_TRACES_SAMPLER=parentbased_always_on

# Opt-in client telemetry (MAZ-129; see docs/self-hosting/observability.md#client-telemetry).
# Off unless a collector is set. The web and iOS apps post to the API, which forwards from
# here, so the collector stays private: your Alloy on the penny network, or Grafana Cloud.
# ClientTelemetry__FaroUrl=http://alloy:12347/collect
# ClientTelemetry__OtlpEndpoint=http://alloy:4319
# ClientTelemetry__OtlpHeaders=Authorization=Basic%20<base64 instance:token>
# ClientTelemetry__SessionReplay=false
# ClientTelemetry__RateLimitPermits=120
# ClientTelemetry__MaxPayloadBytes=1048576
