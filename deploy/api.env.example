# Optional API settings for deploy/compose.yaml (MAZ-63). Copy to deploy/api.env
# (mode 0600) and uncomment what you use; it is passed to the `api` service only.
# Every key is documented in docs/deployment.md#configuration.

# Registration
# Auth__AllowRegistration=true

# OpenID Connect sign-in (all of Issuer, ClientId and RedirectUris, or none)
# Oidc__Issuer=https://auth.example.com/application/o/penny/
# Oidc__ClientId=penny
# Oidc__ClientSecret=
# Oidc__RedirectUris=https://penny.example.com/auth/callback,penny://auth/callback
# Oidc__Label=Single sign-on
# Oidc__AllowRegistration=false

# APNs push (all four, or none). Prefer the PEM text from your secret manager; a key
# file must be mounted read-only and readable by uid 1654.
# Push__Apns__TeamId=
# Push__Apns__KeyId=
# Push__Apns__Topic=
# Push__Apns__PrivateKey=
# Push__Expo__Enabled=true

# Workers: run them in exactly the processes you choose (see docs/deployment.md#topology)
# Recurrence__Worker=true
# Push__Worker=true
# Search__EmbeddingWorker=true

# Limits
# Database__MaxPoolSize=20
# Receipts__MinFreeMegabytes=100
# Logging__LogLevel__Default=Information

# OpenTelemetry traces, metrics and logs over OTLP (off unless the endpoint is set).
# See docs/operations.md#telemetry-opentelemetry. Headers are a secret.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=penny-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=home
# OTEL_TRACES_SAMPLER=parentbased_always_on
