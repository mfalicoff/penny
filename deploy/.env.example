# Compose settings and secrets for deploy/compose.yaml. Copy to deploy/.env, keep it
# private (chmod 600) and fill in every empty value:
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#   openssl rand -hex 24      # each of the three passwords (hex: no ';' allowed)
#   openssl rand -base64 32   # PENNY_RECEIPT_KEY
#
# Back up deploy/.env (or at least PENNY_RECEIPT_KEY) in your secret manager: without
# the receipt key, stored receipts cannot be decrypted. Changing a password here does
# not change it in an existing database, and a new receipt key cannot read old receipts.
# Every variable is documented in docs/deployment.md#configuration.

# The origin users open in the browser (scheme, host, non-default port; no path).
PENNY_PUBLIC_ORIGIN=https://penny.example.com
# false only for an http://localhost origin.
PENNY_SECURE_COOKIES=true

PENNY_ADMIN_PASSWORD=
PENNY_MIGRATION_PASSWORD=
PENNY_RUNTIME_PASSWORD=
PENNY_RECEIPT_KEY=

# Empty for an external PostgreSQL (then also set PENNY_DB_HOST/PORT/NAME,
# PENNY_DB_SSL_MODE=VerifyFull and PENNY_DB_OPTIONS).
COMPOSE_PROFILES=bundled-postgres

# Opt-in browser telemetry (errors, performance, traces) for the web app: the Faro collector
# URL from Grafana Cloud (Frontend Observability) or your own Alloy. Empty keeps it off.
# See docs/observability.md#web-app-telemetry.
PENNY_WEB_TELEMETRY_URL=

# Pin released images instead of latest, e.g. ghcr.io/mfalicoff/penny-api:2.0.0
PENNY_API_IMAGE=ghcr.io/mfalicoff/penny-api:latest
PENNY_WEB_IMAGE=ghcr.io/mfalicoff/penny-web:latest

# Published address of the web container; put your TLS proxy in front of it.
PENNY_BIND=127.0.0.1
PENNY_PORT=8080
