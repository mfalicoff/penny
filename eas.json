{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "play-internal": {
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ipa": {
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {}
    }
  }
}
