{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Update Expo SDK dependencies together using expo install, not independent Renovate upgrades.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "@react-native-*/*",
        "@types/react",
        "eslint-config-expo",
        "jest-expo"
      ],
      "enabled": false
    }
  ]
}
