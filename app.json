{
  "expo": {
    "name": "Penny",
    "slug": "penny-expense-tracker",
    "orientation": "portrait",
    "icon": "./assets/penny-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mfalicoff.penny",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Penny to use Face ID to protect your financial information."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BalanceChartWidget",
              "displayName": "Monthly balance",
              "description": "Income and expenses at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "RecentExpensesWidget",
              "displayName": "Recent expenses",
              "description": "Recent spending and a shortcut to add an expense",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "scheme": "penny",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42509ccd-a59b-4cb7-9370-3bd3a559de61"
      }
    },
    "owner": "mfalicoff"
  }
}
