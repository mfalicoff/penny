{
  "expo": {
    "name": "Penny",
    "slug": "penny-expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mfalicoff.penny",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mfalicoff.penny",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BalanceChartWidget",
              "displayName": "Monthly balance",
              "description": "Income and expenses at a glance",
              "ios": { "supportedFamilies": ["systemSmall"], "contentMarginsDisabled": true }
            },
            {
              "name": "RecentExpensesWidget",
              "displayName": "Recent expenses",
              "description": "Recent spending and a shortcut to add an expense",
              "ios": { "supportedFamilies": ["systemSmall"], "contentMarginsDisabled": true }
            }
          ]
        }
      ]
    ],
    "scheme": "penny",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42509ccd-a59b-4cb7-9370-3bd3a559de61"
      }
    },
    "owner": "mfalicoff"
  }
}
