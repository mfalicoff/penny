{
  "description": "Golden shared-expense split cases for calculateHouseholdSplits (src/domain/households.ts) and the .NET HouseholdSplits port. Amounts are integer cents; `error: true` means the split is rejected.",
  "cases": [
    {
      "name": "equal remainder goes to the lexically first members",
      "totalCents": 10000,
      "input": {
        "mode": "equal",
        "memberIds": [
          "c",
          "b",
          "a"
        ]
      },
      "expected": [
        {
          "userId": "a",
          "amountCents": 3334
        },
        {
          "userId": "b",
          "amountCents": 3333
        },
        {
          "userId": "c",
          "amountCents": 3333
        }
      ]
    },
    {
      "name": "equal split of one cent leaves zero shares",
      "totalCents": 1,
      "input": {
        "mode": "equal",
        "memberIds": [
          "cam",
          "alex",
          "bea"
        ]
      },
      "expected": [
        {
          "userId": "alex",
          "amountCents": 1
        },
        {
          "userId": "bea",
          "amountCents": 0
        },
        {
          "userId": "cam",
          "amountCents": 0
        }
      ]
    },
    {
      "name": "equal split of the largest total",
      "totalCents": 99999999999,
      "input": {
        "mode": "equal",
        "memberIds": [
          "g",
          "f",
          "e",
          "d",
          "c",
          "b",
          "a"
        ]
      },
      "expected": [
        {
          "userId": "a",
          "amountCents": 14285714286
        },
        {
          "userId": "b",
          "amountCents": 14285714286
        },
        {
          "userId": "c",
          "amountCents": 14285714286
        },
        {
          "userId": "d",
          "amountCents": 14285714286
        },
        {
          "userId": "e",
          "amountCents": 14285714285
        },
        {
          "userId": "f",
          "amountCents": 14285714285
        },
        {
          "userId": "g",
          "amountCents": 14285714285
        }
      ]
    },
    {
      "name": "equal split with one member",
      "totalCents": 4321,
      "input": {
        "mode": "equal",
        "memberIds": [
          "solo"
        ]
      },
      "expected": [
        {
          "userId": "solo",
          "amountCents": 4321
        }
      ]
    },
    {
      "name": "equal split rejects duplicate members",
      "totalCents": 100,
      "input": {
        "mode": "equal",
        "memberIds": [
          "a",
          "a"
        ]
      },
      "error": true
    },
    {
      "name": "equal split rejects no members",
      "totalCents": 100,
      "input": {
        "mode": "equal",
        "memberIds": []
      },
      "error": true
    },
    {
      "name": "equal split rejects a zero total",
      "totalCents": 0,
      "input": {
        "mode": "equal",
        "memberIds": [
          "a"
        ]
      },
      "error": true
    },
    {
      "name": "exact shares are reordered by member",
      "totalCents": 10000,
      "input": {
        "mode": "exact",
        "allocations": [
          {
            "userId": "b",
            "amountCents": 7250
          },
          {
            "userId": "a",
            "amountCents": 2750
